{
  "fail_closed": false,
  "protected_branches": ["main", "master"],
  "rules": {
    "destructive_shell": { "enabled": true, "mode": "block" },
    "secrets_in_content": { "enabled": true, "mode": "block", "ignore_paths": ["*.md", "*.example", "test*", "docs/**"] },
    "protected_paths": {
      "enabled": true,
      "mode": "block",
      "paths": [".env", ".env.*", "**/*.pem", "**/*.key", "**/id_rsa*", ".git/**", "**/.git/**", "**/secrets/**", ".claude/guardrails.json", ".claude/guardrails.*.json", ".claude/settings.json", ".claude/settings.local.json", "LICENSE"],
      "allow_paths": [".env.example"],
      "scope": { "enabled": false, "allowed_paths": [] }
    },
    "scope_shell": {
      "enabled": true,
      "mode": "block",
      "blocked_commands": ["npm publish", "twine upload", "cargo publish", "gh release create"]
    }
  },
  "audit": { "enabled": true, "path": ".claude/guardrails-audit.jsonl" }
}
